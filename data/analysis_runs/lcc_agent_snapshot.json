                      "body": "Interactome stats and Curated coverage"
                    }
                  },
                  {
                    "type": "info",
                    "props": {
                      "body": "Coverage is the percentage of the mapped Curated protein set present in each interactome. Network size and density describe the retained graph; coverage is not evidence that a protein or interaction is absent biologically."
                    }
                  },
                  {
                    "type": "columns",
                    "children": [
                      {
